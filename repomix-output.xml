"use client";

import React, { useState, useEffect, useRef } from "react";
import {
  Sparkles,
  Send,
  Bot,
  User,
  ExternalLink,
  ChevronDown,
  ChevronUp,
  Layers,
  Network,
  Code2,
  RefreshCw,
  HelpCircle,
  FileCode,
} from "lucide-react";

interface Citation {
  file_path: string;
  start_line: number;
  end_line: number;
  symbol_name?: string;
  snippet: string;
  confidence_score: number;
}

interface RetrievedChunk {
  chunk_id: string;
  file_path: string;
  symbol_fqn?: string;
  kind?: string;
  start_line: number;
  end_line: number;
  content: string;
  score: number;
  match_type: string;
  graph_context?: {
    symbol_fqn: string;
    kind: string;
    callers: string[];
    callees: string[];
  };
}

interface ChatMessage {
  id: string;
  role: "user" | "assistant" | "system";
  content: string;
  citations?: Citation[];
  retrieved_chunks?: RetrievedChunk[];
}

interface ChatAssistantProps {
  repositoryId: string;
  repositoryName: string;
  embeddingModel?: string;
  onSelectFile?: (filePath: string, line?: number) => void;
}

const API_BASE = process.env.NEXT_PUBLIC_API_URL || "http://localhost:8000";

export default function ChatAssistant({
  repositoryId,
  repositoryName,
  embeddingModel = "models/gemini-embedding-2",
  onSelectFile,
}: ChatAssistantProps) {
  const [messages, setMessages] = useState<ChatMessage[]>([
    {
      id: "welcome",
      role: "assistant",
      content: `Hello! I am RepoLens AI, grounded in **${repositoryName}** AST symbol tables, call graphs, and dense vector embeddings.\n\nAsk me about architecture, function workflows, data models, or cross-file dependencies. Every claim is strictly grounded with verified code citations.`,
    },
  ]);
  const [inputQuery, setInputQuery] = useState("");
  const [sessionId, setSessionId] = useState<string | null>(null);
  const [isLoading, setIsLoading] = useState(false);
  const [expandedSourcesMsgId, setExpandedSourcesMsgId] = useState<string | null>(null);
  const messagesEndRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages, isLoading]);

  const handleSendMessage = async (queryText?: string) => {
    const textToSend = queryText || inputQuery;
    if (!textToSend.trim() || isLoading) return;

    const userMsg: ChatMessage = {
      id: `user-${Date.now()}`,
      role: "user",
      content: textToSend.trim(),
    };

    setMessages((prev) => [...prev, userMsg]);
    if (!queryText) setInputQuery("");
    setIsLoading(true);

    try {
      const res = await fetch(`${API_BASE}/api/v1/repositories/${repositoryId}/chat`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          message: textToSend.trim(),
          session_id: sessionId,
        }),
      });

      if (res.ok) {
        const data = await res.json();
        setSessionId(data.session_id);
        const assistantMsg: ChatMessage = {
          id: data.message_id,
          role: "assistant",
          content: data.response,
          citations: data.citations,
          retrieved_chunks: data.retrieved_chunks,
        };
        setMessages((prev) => [...prev, assistantMsg]);
      } else {
        const errData = await res.json().catch(() => ({}));
        setMessages((prev) => [
          ...prev,
          {
            id: `err-${Date.now()}`,
            role: "assistant",
            content: `⚠️ **Error generating grounded response:** ${errData.detail || res.statusText}`,
          },
        ]);
      }
    } catch (err: any) {
      setMessages((prev) => [
        ...prev,
        {
          id: `err-${Date.now()}`,
          role: "assistant",
          content: `⚠️ **Network error:** ${err.message || "Failed to reach API"}`,
        },
      ]);
    } finally {
      setIsLoading(false);
    }
  };

  const samplePrompts = [
    "Explain the core authentication and user login flow",
    "What are the main API route endpoints and handlers?",
    "Show the database models and their relationships",
    "What functions depend on the primary business service?",
  ];

  return (
    <div className="flex flex-col h-full bg-[#0D1117] border border-white/5 rounded-xl overflow-hidden">
      {/* Header */}
      <div className="flex items-center justify-between px-5 py-3.5 bg-[#131822] border-b border-white/5">
        <div className="flex items-center gap-2.5">
          <div className="p-1.5 rounded-lg bg-indigo-500/10 border border-indigo-500/20 text-indigo-400">
            <Sparkles className="w-4 h-4" />
          </div>
          <div>
            <div className="flex items-center gap-2">
              <h3 className="text-sm font-semibold text-white">Grounded Codebase Assistant</h3>
              <span className="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-mono">
                RAG Active
              </span>
            </div>
            <p className="text-xs text-slate-400 font-mono">
              Model: {embeddingModel} &bull; 768-dim pgvector
            </p>
          </div>
        </div>
        <button
          onClick={() => {
            setSessionId(null);
            setMessages([
              {
                id: "welcome",
                role: "assistant",
                content: `Chat session reset. Ready to answer questions grounded in **${repositoryName}**.`,
              },
            ]);
          }}
          className="flex items-center gap-1.5 px-2.5 py-1.5 text-xs text-slate-400 hover:text-white bg-white/5 hover:bg-white/10 rounded-lg transition"
          title="Start New Session"
        >
          <RefreshCw className="w-3.5 h-3.5" />
          New Session
        </button>
      </div>

      {/* Messages Stream */}
      <div className="flex-1 overflow-y-auto p-5 space-y-4 font-sans text-sm">
        {messages.map((msg) => (
          <div
            key={msg.id}
            className={`flex gap-3 ${msg.role === "user" ? "justify-end" : "justify-start"}`}
          >
            {msg.role !== "user" && (
              <div className="w-7 h-7 rounded-lg bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400 shrink-0 mt-0.5">
                <Bot className="w-4 h-4" />
              </div>
            )}

            <div
              className={`max-w-[85%] rounded-xl p-4 ${
                msg.role === "user"
                  ? "bg-indigo-600/90 text-white rounded-tr-none shadow-md shadow-indigo-600/10"
                  : "bg-[#161B26] border border-white/5 text-slate-200 rounded-tl-none"
              }`}
            >
              <div className="whitespace-pre-wrap leading-relaxed space-y-2">
                {msg.content}
              </div>

              {/* Citations Badges */}
              {msg.citations && msg.citations.length > 0 && (
                <div className="mt-3.5 pt-3 border-t border-white/5">
                  <div className="text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-1.5">
                    <FileCode className="w-3.5 h-3.5 text-indigo-400" />
                    Verified Citations & Sources:
                  </div>
                  <div className="flex flex-wrap gap-1.5">
                    {msg.citations.map((cit, idx) => (
                      <button
                        key={idx}
                        onClick={() => onSelectFile?.(cit.file_path, cit.start_line)}
                        className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-indigo-500/10 hover:bg-indigo-500/20 text-indigo-300 hover:text-white border border-indigo-500/20 text-xs font-mono transition"
                      >
                        <span>
                          {cit.file_path}:{cit.start_line}
                          {cit.end_line > cit.start_line ? `-${cit.end_line}` : ""}
                        </span>
                        <ExternalLink className="w-3 h-3 opacity-60" />
                      </button>
                    ))}
                  </div>
                </div>
              )}

              {/* Collapsible Retrieved Chunks & Graph Context Drawer */}
              {msg.retrieved_chunks && msg.retrieved_chunks.length > 0 && (
                <div className="mt-3">
                  <button
                    onClick={() =>
                      setExpandedSourcesMsgId(
                        expandedSourcesMsgId === msg.id ? null : msg.id
                      )
                    }
                    className="flex items-center gap-1.5 text-xs text-slate-400 hover:text-slate-200 transition font-mono"
                  >
                    <Layers className="w-3.5 h-3.5 text-indigo-400" />
                    <span>
                      {expandedSourcesMsgId === msg.id ? "Hide" : "Inspect"}{" "}
                      {msg.retrieved_chunks.length} Retrieved Graph & Chunk Sources
                    </span>
                    {expandedSourcesMsgId === msg.id ? (
                      <ChevronUp className="w-3.5 h-3.5" />
                    ) : (
                      <ChevronDown className="w-3.5 h-3.5" />
                    )}
                  </button>

                  {expandedSourcesMsgId === msg.id && (
                    <div className="mt-2.5 space-y-2 pt-2">
                      {msg.retrieved_chunks.map((rc, idx) => (
                        <div
                          key={idx}
                          className="p-2.5 rounded-lg bg-[#0E131C] border border-white/5 text-xs font-mono space-y-1.5"
                        >
                          <div className="flex items-center justify-between text-slate-300">
                            <span className="font-semibold text-indigo-300">
                              {rc.file_path} (lines {rc.start_line}-{rc.end_line})
                            </span>
                            <div className="flex items-center gap-2">
                              <span className="px-1.5 py-0.5 rounded bg-white/5 text-[10px] text-slate-400 uppercase">
                                {rc.match_type}
                              </span>
                              <span className="text-emerald-400 font-semibold text-[11px]">
                                {Math.round(rc.score * 100)}% Match
                              </span>
                            </div>
                          </div>

                          {rc.graph_context && (
                            <div className="text-[11px] text-slate-400 bg-white/[0.02] p-1.5 rounded border border-white/5">
                              {rc.graph_context.callers.length > 0 && (
                                <div>
                                  <span className="text-amber-400 font-semibold">Callers:</span>{" "}
                                  {rc.graph_context.callers.join(", ")}
                                </div>
                              )}
                              {rc.graph_context.callees.length > 0 && (
                                <div>
                                  <span className="text-cyan-400 font-semibold">Callees:</span>{" "}
                                  {rc.graph_context.callees.join(", ")}
                                </div>
                              )}
                            </div>
                          )}

                          <pre className="p-2 rounded bg-black/40 text-slate-300 text-[11px] overflow-x-auto max-h-28">
                            <code>{rc.content}</code>
                          </pre>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )}
            </div>

            {msg.role === "user" && (
              <div className="w-7 h-7 rounded-lg bg-slate-700/50 border border-white/10 flex items-center justify-center text-slate-300 shrink-0 mt-0.5">
                <User className="w-4 h-4" />
              </div>
            )}
          </div>
        ))}

        {isLoading && (
          <div className="flex gap-3 justify-start items-center text-slate-400 text-xs py-2">
            <div className="w-7 h-7 rounded-lg bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400 animate-pulse">
              <Sparkles className="w-4 h-4" />
            </div>
            <div className="flex items-center gap-2">
              <span className="inline-block w-2 h-2 rounded-full bg-indigo-500 animate-ping" />
              <span>Executing Hybrid RAG & Graph Context Expansion...</span>
            </div>
          </div>
        )}

        <div ref={messagesEndRef} />
      </div>

      {/* Suggested Prompt Chips */}
      {messages.length <= 2 && (
        <div className="px-5 py-2.5 bg-[#10141D] border-t border-white/5">
          <div className="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-2 flex items-center gap-1.5">
            <HelpCircle className="w-3.5 h-3.5 text-indigo-400" />
            Suggested Architectural Questions:
          </div>
          <div className="flex flex-wrap gap-2">
            {samplePrompts.map((prompt, idx) => (
              <button
                key={idx}
                onClick={() => handleSendMessage(prompt)}
                className="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-xs text-slate-300 hover:text-white border border-white/5 transition text-left"
              >
                {prompt}
              </button>
            ))}
          </div>
        </div>
      )}

      {/* Input Form */}
      <div className="p-4 bg-[#131822] border-t border-white/5">
        <form
          onSubmit={(e) => {
            e.preventDefault();
            handleSendMessage();
          }}
          className="flex items-center gap-2"
        >
          <input
            type="text"
            value={inputQuery}
            onChange={(e) => setInputQuery(e.target.value)}
            placeholder="Ask about architecture, functions, call graphs, or data models..."
            className="flex-1 px-4 py-2.5 rounded-lg bg-[#0A0D14] border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-indigo-500 transition font-sans"
            disabled={isLoading}
          />
          <button
            type="submit"
            disabled={!inputQuery.trim() || isLoading}
            className="px-4 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 text-white font-medium text-sm flex items-center gap-1.5 transition shadow-lg shadow-indigo-600/20"
          >
            <Send className="w-4 h-4" />
            <span>Send</span>
          </button>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="apps/web/components/CodeSearch.tsx">
"use client";

import React, { useState } from "react";
import {
  Search,
  SlidersHorizontal,
  Code2,
  ExternalLink,
  Layers,
  Sparkles,
  Zap,
  Filter,
  CheckCircle2,
  FileCode,
} from "lucide-react";

interface SearchResultItem {
  chunk_id: string;
  file_path: string;
  symbol_fqn?: string;
  kind?: string;
  start_line: number;
  end_line: number;
  content: string;
  score: number;
  match_type: string;
  graph_context?: {
    symbol_fqn: string;
    kind: string;
    callers: string[];
    callees: string[];
  };
  embedding_model?: string;
}

interface CodeSearchProps {
  repositoryId: string;
  languages?: string[];
  onSelectFile?: (filePath: string, line?: number) => void;
}

const API_BASE = process.env.NEXT_PUBLIC_API_URL || "http://localhost:8000";

export default function CodeSearch({
  repositoryId,
  languages = ["python", "typescript", "javascript"],
  onSelectFile,
}: CodeSearchProps) {
  const [query, setQuery] = useState("");
  const [mode, setMode] = useState<"hybrid" | "semantic" | "exact">("hybrid");
  const [selectedLanguage, setSelectedLanguage] = useState<string>("");
  const [selectedKind, setSelectedKind] = useState<string>("");
  const [results, setResults] = useState<SearchResultItem[]>([]);
  const [isSearching, setIsSearching] = useState(false);
  const [hasSearched, setHasSearched] = useState(false);

  const handleSearch = async (e?: React.FormEvent) => {
    if (e) e.preventDefault();
    if (!query.trim()) return;

    setIsSearching(true);
    setHasSearched(true);

    try {
      const res = await fetch(`${API_BASE}/api/v1/repositories/${repositoryId}/search`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          query: query.trim(),
          mode: mode,
          language: selectedLanguage || null,
          kind: selectedKind || null,
          limit: 15,
        }),
      });

      if (res.ok) {
        const data = await res.json();
        setResults(data.results || []);
      } else {
        setResults([]);
      }
    } catch (err) {
      console.error("Search failed:", err);
      setResults([]);
    } finally {
      setIsSearching(false);
    }
  };

  const sampleQueries = [
    { text: "AuthService", mode: "exact" as const },
    { text: "user authentication and token verification", mode: "semantic" as const },
    { text: "login_endpoint", mode: "exact" as const },
    { text: "database model entity relations", mode: "hybrid" as const },
  ];

  return (
    <div className="flex flex-col h-full bg-[#0D1117] border border-white/5 rounded-xl overflow-hidden">
      {/* Search Header & Controls */}
      <div className="p-5 bg-[#131822] border-b border-white/5 space-y-3.5">
        <form onSubmit={handleSearch} className="flex items-center gap-2">
          <div className="relative flex-1">
            <Search className="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" />
            <input
              type="text"
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              placeholder="Search code by exact symbol, natural language concept, or file path..."
              className="w-full pl-10 pr-4 py-2.5 rounded-lg bg-[#0A0D14] border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-indigo-500 transition font-sans"
            />
          </div>
          <button
            type="submit"
            disabled={!query.trim() || isSearching}
            className="px-5 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 text-white font-medium text-sm flex items-center gap-1.5 transition shadow-lg shadow-indigo-600/20"
          >
            <Search className="w-4 h-4" />
            <span>{isSearching ? "Searching..." : "Search"}</span>
          </button>
        </form>

        {/* Filters & Mode Pills */}
        <div className="flex flex-wrap items-center justify-between gap-3 text-xs">
          {/* Mode Selector */}
          <div className="flex items-center gap-1.5 bg-black/40 p-1 rounded-lg border border-white/5">
            <span className="text-slate-400 px-2 font-mono text-[11px]">Mode:</span>
            {(["hybrid", "semantic", "exact"] as const).map((m) => (
              <button
                key={m}
                type="button"
                onClick={() => setMode(m)}
                className={`px-2.5 py-1 rounded-md transition font-medium capitalize ${
                  mode === m
                    ? "bg-indigo-600 text-white shadow-sm"
                    : "text-slate-400 hover:text-slate-200"
                }`}
              >
                {m === "hybrid" ? "⚡ Hybrid (RRF)" : m === "semantic" ? "🧠 Semantic Vector" : "🎯 Exact Symbol"}
              </button>
            ))}
          </div>

          {/* Metadata Filters */}
          <div className="flex items-center gap-2">
            <div className="flex items-center gap-1 bg-black/40 px-2.5 py-1 rounded-lg border border-white/5 text-slate-300">
              <Filter className="w-3.5 h-3.5 text-slate-400" />
              <select
                value={selectedLanguage}
                onChange={(e) => setSelectedLanguage(e.target.value)}
                className="bg-transparent text-xs text-slate-300 focus:outline-none cursor-pointer"
              >
                <option value="" className="bg-[#131822]">All Languages</option>
                {languages.map((l) => (
                  <option key={l} value={l} className="bg-[#131822]">
                    {l}
                  </option>
                ))}
              </select>
            </div>

            <div className="flex items-center gap-1 bg-black/40 px-2.5 py-1 rounded-lg border border-white/5 text-slate-300">
              <select
                value={selectedKind}
                onChange={(e) => setSelectedKind(e.target.value)}
                className="bg-transparent text-xs text-slate-300 focus:outline-none cursor-pointer"
              >
                <option value="" className="bg-[#131822]">All Kinds</option>
                <option value="function" className="bg-[#131822]">Functions</option>
                <option value="class" className="bg-[#131822]">Classes</option>
                <option value="method" className="bg-[#131822]">Methods</option>
                <option value="api_endpoint" className="bg-[#131822]">API Endpoints</option>
                <option value="db_model" className="bg-[#131822]">DB Models</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      {/* Results Container */}
      <div className="flex-1 overflow-y-auto p-5 space-y-3 font-sans">
        {results.length > 0 ? (
          <div className="space-y-3">
            <div className="flex items-center justify-between text-xs text-slate-400 px-1 font-mono">
              <span>Found {results.length} ranked code chunks</span>
              <span>Sorted by RRF relevance</span>
            </div>

            {results.map((item) => (
              <div
                key={item.chunk_id}
                className="p-4 rounded-xl bg-[#131822] border border-white/5 hover:border-indigo-500/30 transition space-y-2.5"
              >
                {/* Result Header */}
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-2">
                    <FileCode className="w-4 h-4 text-indigo-400" />
                    <span className="font-mono text-xs font-semibold text-white">
                      {item.file_path}
                    </span>
                    <span className="text-slate-400 text-xs font-mono">
                      (lines {item.start_line}-{item.end_line})
                    </span>
                  </div>

                  <div className="flex items-center gap-2">
                    <span className="px-2 py-0.5 rounded-full bg-white/5 text-[10px] uppercase font-mono text-slate-300 border border-white/10">
                      {item.match_type}
                    </span>
                    <span className="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-mono font-semibold">
                      {Math.round(item.score * 100)}% match
                    </span>
                    <button
                      onClick={() => onSelectFile?.(item.file_path, item.start_line)}
                      className="p-1 rounded-md bg-white/5 hover:bg-indigo-600/30 text-slate-400 hover:text-white transition"
                      title="Inspect in Editor"
                    >
                      <ExternalLink className="w-3.5 h-3.5" />
                    </button>
                  </div>
                </div>

                {/* Symbol FQN & Graph Tags */}
                {item.symbol_fqn && (
                  <div className="flex items-center gap-2 text-xs font-mono">
                    <span className="text-indigo-300 font-semibold">{item.symbol_fqn}</span>
                    {item.kind && (
                      <span className="px-1.5 py-0.5 rounded bg-indigo-950 text-indigo-400 text-[10px]">
                        {item.kind}
                      </span>
                    )}
                  </div>
                )}

                {/* Graph Context (Callers/Callees) */}
                {item.graph_context && (
                  <div className="p-2 rounded bg-black/40 border border-white/5 text-[11px] font-mono space-y-1">
                    {item.graph_context.callers.length > 0 && (
                      <div className="text-slate-300">
                        <span className="text-amber-400 font-semibold">Callers:</span>{" "}
                        {item.graph_context.callers.join(", ")}
                      </div>
                    )}
                    {item.graph_context.callees.length > 0 && (
                      <div className="text-slate-300">
                        <span className="text-cyan-400 font-semibold">Callees:</span>{" "}
                        {item.graph_context.callees.join(", ")}
                      </div>
                    )}
                  </div>
                )}

                {/* Code Snippet */}
                <pre className="p-3 rounded-lg bg-black/50 text-slate-200 text-xs font-mono overflow-x-auto border border-white/5 max-h-40">
                  <code>{item.content}</code>
                </pre>
              </div>
            ))}
          </div>
        ) : (
          <div className="flex flex-col items-center justify-center h-full text-slate-500 py-12 space-y-4">
            <div className="p-4 rounded-full bg-white/5 border border-white/5 text-slate-400">
              <Search className="w-8 h-8" />
            </div>
            <div className="text-center space-y-1">
              <p className="text-sm font-medium text-slate-300">
                {hasSearched ? "No matching code chunks found" : "Ready to search codebase"}
              </p>
              <p className="text-xs text-slate-500 max-w-sm">
                Try searching for specific symbols or natural language queries.
              </p>
            </div>

            {/* Quick Starter Chips */}
            <div className="flex flex-wrap justify-center gap-2 max-w-md pt-2">
              {sampleQueries.map((sq, idx) => (
                <button
                  key={idx}
                  onClick={() => {
                    setQuery(sq.text);
                    setMode(sq.mode);
                  }}
                  className="px-3 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-xs text-slate-400 hover:text-white border border-white/5 transition"
                >
                  {sq.text}
                </button>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
</file>

<file path="apps/web/components/DependencyGraph.tsx">
"use client";

import React, { useState, useEffect, useMemo, useCallback } from "react";
import {
  ReactFlow,
  Background,
  Controls,
  MiniMap,
  Handle,
  Position,
  useNodesState,
  useEdgesState,
  MarkerType,
  Node,
  Edge,
  NodeProps,
} from "@xyflow/react";
import {
  Layers,
  Code,
  Cpu,
  Zap,
  Search,
  Filter,
  ArrowRight,
  Maximize2,
  FileCode,
  Compass,
  CornerDownRight,
  Sparkles,
} from "lucide-react";

type GraphNodeData = {
  id: string;
  label: string;
  fqn: string;
  kind: string;
  filePath: string;
  lineRange: [number, number];
  signature?: string;
  docstring?: string;
  isSelected?: boolean;
  [key: string]: unknown;
};

type SymbolNodeType = Node<GraphNodeData, "symbolNode">;

// Custom Themed Symbol Node
const SymbolNode = ({ data, selected }: NodeProps<SymbolNodeType>) => {
  const getBadgeStyle = (kind: string) => {
    switch (kind) {
      case "api_endpoint":
        return "bg-electric-emerald/20 text-electric-emerald border-electric-emerald/40";
      case "db_model":
        return "bg-electric-violet/20 text-electric-violet border-electric-violet/40";
      case "class":
        return "bg-electric-violet/15 text-electric-violet border-electric-violet/30";
      case "component":
        return "bg-electric-cyan/20 text-electric-cyan border-electric-cyan/40";
      case "hook":
        return "bg-electric-cyan/15 text-electric-cyan border-electric-cyan/30";
      case "interface":
        return "bg-electric-amber/20 text-electric-amber border-electric-amber/40";
      case "method":
        return "bg-electric-indigo/15 text-electric-indigo border-electric-indigo/30";
      default:
        return "bg-electric-indigo/20 text-electric-indigo border-electric-indigo/40";
    }
  };

  return (
    <div
      className={`px-4 py-3 rounded-xl bg-obsidian-surface/95 border backdrop-blur-md transition-all duration-200 min-w-[220px] max-w-[320px] shadow-lg ${
        selected
          ? "border-electric-indigo shadow-glow ring-1 ring-electric-indigo"
          : "border-obsidian-border hover:border-gray-600 hover:shadow-glow"
      }`}
    >
      <Handle
        type="target"
        position={Position.Top}
        className="w-2.5 h-2.5 !bg-electric-indigo border border-obsidian-base"
      />

      <div className="flex items-center justify-between gap-2 mb-1.5">
        <span
          className={`text-[9px] font-mono font-bold uppercase px-1.5 py-0.5 rounded border ${getBadgeStyle(
            data.kind
          )}`}
        >
          {data.kind.replace("_", " ")}
        </span>
        <span className="text-[10px] font-mono text-gray-400">
          L{data.lineRange?.[0]}
        </span>
      </div>

      <div className="font-mono text-xs font-bold text-white truncate">
        {data.label}
      </div>

      {data.filePath && (
        <div className="text-[10px] font-mono text-gray-400 truncate mt-1 flex items-center gap-1">
          <FileCode className="w-3 h-3 text-gray-400 shrink-0" />
          <span className="truncate">{data.filePath}</span>
        </div>
      )}

      {data.signature && (
        <div className="mt-2 text-[10px] font-mono text-gray-300 bg-obsidian-base/80 px-2 py-1 rounded border border-obsidian-border/50 truncate">
          {data.signature}
        </div>
      )}

      <Handle
        type="source"
        position={Position.Bottom}
        className="w-2.5 h-2.5 !bg-electric-violet border border-obsidian-base"
      />
    </div>
  );
};

const nodeTypes = {
  symbolNode: SymbolNode,
};

interface DependencyGraphProps {
  repositoryId: string;
  onSelectSymbol?: (symbolId: string) => void;
}

export default function DependencyGraph({
  repositoryId,
  onSelectSymbol,
}: DependencyGraphProps) {
  const [graphData, setGraphData] = useState<{
    total_nodes: number;
    total_edges: number;
    nodes: any[];
    edges: any[];
    files_count: number;
  } | null>(null);

  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  // Filters
  const [searchQuery, setSearchQuery] = useState("");
  const [selectedKind, setSelectedKind] = useState<string>("ALL");
  const [selectedFileFilter, setSelectedFileFilter] = useState<string>("ALL");

  // Selected Node in Graph
  const [selectedNodeData, setSelectedNodeData] = useState<GraphNodeData | null>(null);
  const [selectedSymbolDetail, setSelectedSymbolDetail] = useState<{
    symbol: any;
    callers: any[];
    callees: any[];
  } | null>(null);

  const [nodes, setNodes, onNodesChange] = useNodesState<Node>([]);
  const [edges, setEdges, onEdgesChange] = useEdgesState<Edge>([]);

  const API_BASE = process.env.NEXT_PUBLIC_API_URL || "http://localhost:8000";

  // Fetch Graph Data
  const fetchGraph = useCallback(async () => {
    setIsLoading(true);
    setError(null);
    try {
      const res = await fetch(`${API_BASE}/api/v1/repositories/${repositoryId}/graph`);
      if (!res.ok) {
        throw new Error("Failed to fetch repository dependency graph");
      }
      const data = await res.json();
      setGraphData(data);
    } catch (err: any) {
      setError(err.message || "Failed to load dependency graph");
    } finally {
      setIsLoading(false);
    }
  }, [API_BASE, repositoryId]);

  useEffect(() => {
    if (repositoryId) {
      fetchGraph();
    }
  }, [repositoryId, fetchGraph]);

  // Unique files list for filter
  const fileOptions = useMemo(() => {
    if (!graphData) return [];
    const files = new Set<string>();
    graphData.nodes.forEach((n) => {
      if (n.filePath) files.add(n.filePath);
    });
    return Array.from(files).sort();
  }, [graphData]);

  // Layout & Transform Graph Data for React Flow
  useEffect(() => {
    if (!graphData) return;

    // Filter nodes
    const filteredRawNodes = graphData.nodes.filter((n) => {
      const matchesSearch =
        !searchQuery ||
        n.label.toLowerCase().includes(searchQuery.toLowerCase()) ||
        n.filePath.toLowerCase().includes(searchQuery.toLowerCase());

      const matchesKind =
        selectedKind === "ALL" ||
        (selectedKind === "ENDPOINTS" && n.kind === "api_endpoint") ||
        (selectedKind === "CLASSES" && ["class", "db_model"].includes(n.kind)) ||
        (selectedKind === "FUNCTIONS" && ["function", "method"].includes(n.kind)) ||
        (selectedKind === "COMPONENTS" && ["component", "hook"].includes(n.kind)) ||
        (selectedKind === "INTERFACES" && n.kind === "interface");

      const matchesFile =
        selectedFileFilter === "ALL" || n.filePath === selectedFileFilter;

      return matchesSearch && matchesKind && matchesFile;
    });

    const activeNodeIds = new Set(filteredRawNodes.map((n) => n.id));

    // Layout computation: Organize nodes by file clusters
    const fileGroups: { [file: string]: any[] } = {};
    filteredRawNodes.forEach((n) => {
      const f = n.filePath || "root";
      if (!fileGroups[f]) fileGroups[f] = [];
      fileGroups[f].push(n);
    });

    const flowNodes: Node[] = [];
    let fileCol = 0;

    Object.entries(fileGroups).forEach(([file, syms]) => {
      syms.forEach((sym, rowIdx) => {
        flowNodes.push({
          id: sym.id,
          type: "symbolNode",
          position: {
            x: fileCol * 360 + 50,
            y: rowIdx * 160 + 50,
          },
          data: {
            id: sym.id,
            label: sym.label,
            fqn: sym.fqn,
            kind: sym.kind,
            filePath: sym.filePath,
            lineRange: sym.lineRange,
            signature: sym.signature,
            docstring: sym.docstring,
          },
        });
      });
      fileCol++;
    });

    // Edges
    const flowEdges: Edge[] = [];
    graphData.edges.forEach((e) => {
      if (activeNodeIds.has(e.source) && activeNodeIds.has(e.target)) {
        const isSelectedEdge =
          selectedNodeData &&
          (e.source === selectedNodeData.id || e.target === selectedNodeData.id);

        flowEdges.push({
          id: e.id,
          source: e.source,
          target: e.target,
          type: "smoothstep",
          animated: isSelectedEdge || false,
          label: e.label,
          labelStyle: { fill: "#9CA3AF", fontSize: 10, fontFamily: "monospace" },
          labelBgStyle: { fill: "#131620", fillOpacity: 0.8 },
          labelBgPadding: [4, 2],
          labelBgBorderRadius: 4,
          style: {
            stroke: isSelectedEdge ? "#8B5CF6" : "rgba(99, 102, 241, 0.4)",
            strokeWidth: isSelectedEdge ? 2.5 : 1.5,
          },
          markerEnd: {
            type: MarkerType.ArrowClosed,
            width: 14,
            height: 14,
            color: isSelectedEdge ? "#8B5CF6" : "rgba(99, 102, 241, 0.6)",
          },
        });
      }
    });

    setNodes(flowNodes);
    setEdges(flowEdges);
  }, [graphData, searchQuery, selectedKind, selectedFileFilter, selectedNodeData, setNodes, setEdges]);

  // On Node Click -> Load callers & callees
  const handleNodeClick = async (_: any, node: Node) => {
    const nodeData = node.data as unknown as GraphNodeData;
    setSelectedNodeData(nodeData);
    if (onSelectSymbol) {
      onSelectSymbol(node.id);
    }

    try {
      const res = await fetch(
        `${API_BASE}/api/v1/repositories/${repositoryId}/symbols/${node.id}/dependencies`
      );
      if (res.ok) {
        const detail = await res.json();
        setSelectedSymbolDetail(detail);
      }
    } catch {
      // Keep existing data
    }
  };

  return (
    <div className="flex flex-col h-[700px] glass-panel rounded-2xl overflow-hidden border border-obsidian-border relative">
      {/* Top Filter & Command Toolbar */}
      <div className="p-4 border-b border-obsidian-border bg-obsidian-surface/90 backdrop-blur-md flex flex-wrap items-center justify-between gap-3 z-10">
        <div className="flex items-center space-x-3 flex-1 min-w-[280px]">
          {/* Search Box */}
          <div className="relative flex-1 max-w-xs">
            <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-500">
              <Search className="w-3.5 h-3.5" />
            </div>
            <input
              type="text"
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              placeholder="Search symbols or files..."
              className="w-full pl-9 pr-3 py-1.5 rounded-lg bg-obsidian-base border border-obsidian-border text-white text-xs font-mono focus:outline-none focus:border-electric-indigo transition"
            />
          </div>

          {/* Kind Filter */}
          <div className="flex items-center space-x-1 bg-obsidian-base p-1 rounded-lg border border-obsidian-border text-xs font-mono">
            {[
              { id: "ALL", label: "All" },
              { id: "ENDPOINTS", label: "APIs" },
              { id: "CLASSES", label: "Classes" },
              { id: "FUNCTIONS", label: "Functions" },
              { id: "COMPONENTS", label: "React" },
            ].map((tab) => (
              <button
                key={tab.id}
                onClick={() => setSelectedKind(tab.id)}
                className={`px-2.5 py-1 rounded text-[11px] font-medium transition ${
                  selectedKind === tab.id
                    ? "bg-electric-indigo text-white shadow-sm"
                    : "text-gray-400 hover:text-white"
                }`}
              >
                {tab.label}
              </button>
            ))}
          </div>

          {/* File Filter Dropdown */}
          {fileOptions.length > 0 && (
            <select
              value={selectedFileFilter}
              onChange={(e) => setSelectedFileFilter(e.target.value)}
              className="px-2.5 py-1.5 rounded-lg bg-obsidian-base border border-obsidian-border text-gray-300 text-xs font-mono focus:outline-none focus:border-electric-indigo"
            >
              <option value="ALL">All Files ({fileOptions.length})</option>
              {fileOptions.map((f) => (
                <option key={f} value={f}>
                  {f}
                </option>
              ))}
            </select>
          )}
        </div>

        {/* Quick Stats */}
        <div className="flex items-center space-x-4 text-xs font-mono text-gray-400">
          <div className="flex items-center space-x-1.5">
            <span className="w-2 h-2 rounded-full bg-electric-indigo"></span>
            <span>{nodes.length} Nodes</span>
          </div>
          <div className="flex items-center space-x-1.5">
            <span className="w-2 h-2 rounded-full bg-electric-violet"></span>
            <span>{edges.length} Edges</span>
          </div>
        </div>
      </div>

      {/* Main Canvas Area */}
      <div className="flex-1 relative flex">
        {isLoading ? (
          <div className="flex-1 flex items-center justify-center space-y-3 flex-col bg-obsidian-base">
            <div className="w-8 h-8 rounded-full border-2 border-electric-indigo border-t-transparent animate-spin"></div>
            <p className="text-xs font-mono text-gray-400">Loading dependency graph...</p>
          </div>
        ) : error ? (
          <div className="flex-1 flex items-center justify-center flex-col bg-obsidian-base p-6 text-center">
            <p className="text-xs font-mono text-electric-rose mb-3">{error}</p>
            <button
              onClick={fetchGraph}
              className="px-3 py-1.5 rounded-lg bg-obsidian-elevated text-xs font-mono text-white border border-obsidian-border"
            >
              Retry
            </button>
          </div>
        ) : nodes.length === 0 ? (
          <div className="flex-1 flex items-center justify-center flex-col bg-obsidian-base p-6 text-center space-y-2">
            <Compass className="w-10 h-10 text-gray-600 mx-auto" />
            <p className="text-sm font-bold text-gray-300">No matching graph nodes</p>
            <p className="text-xs text-gray-500">Try adjusting your search query or filters.</p>
          </div>
        ) : (
          <div className="flex-1 h-full">
            <ReactFlow
              nodes={nodes}
              edges={edges}
              onNodesChange={onNodesChange}
              onEdgesChange={onEdgesChange}
              nodeTypes={nodeTypes}
              onNodeClick={handleNodeClick}
              fitView
              minZoom={0.2}
              maxZoom={1.8}
            >
              <Background color="#1F2937" gap={20} size={1} />
              <Controls />
              <MiniMap
                nodeColor={(node: any) => {
                  switch (node.data?.kind) {
                    case "api_endpoint":
                      return "#10B981";
                    case "db_model":
                    case "class":
                      return "#8B5CF6";
                    case "component":
                      return "#06B6D4";
                    default:
                      return "#6366F1";
                  }
                }}
                maskColor="rgba(11, 13, 19, 0.7)"
              />
            </ReactFlow>
          </div>
        )}

        {/* Selected Node Relationship Detail Inspector Sidebar */}
        {selectedNodeData && (
          <div className="w-80 border-l border-obsidian-border bg-obsidian-surface/95 backdrop-blur-md p-5 overflow-y-auto space-y-5 z-20">
            <div className="flex items-start justify-between border-b border-obsidian-border pb-3">
              <div>
                <span className="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-electric-indigo/20 text-electric-indigo font-bold">
                  {selectedNodeData.kind}
                </span>
                <h3 className="font-bold text-white font-mono text-sm mt-2">
                  {selectedNodeData.label}
                </h3>
                <div className="text-[11px] font-mono text-gray-400 mt-1">
                  {selectedNodeData.filePath}:{selectedNodeData.lineRange?.[0]}
                </div>
              </div>
              <button
                onClick={() => setSelectedNodeData(null)}
                className="text-gray-500 hover:text-white text-xs font-mono"
              >
                ✕
              </button>
            </div>

            {selectedNodeData.signature && (
              <div className="space-y-1">
                <div className="text-[10px] font-mono uppercase text-gray-500 font-bold">
                  Signature
                </div>
                <pre className="text-[11px] font-mono text-gray-300 bg-obsidian-base p-2.5 rounded-lg border border-obsidian-border overflow-x-auto">
                  {selectedNodeData.signature}
                </pre>
              </div>
            )}

            {selectedNodeData.docstring && (
              <div className="space-y-1">
                <div className="text-[10px] font-mono uppercase text-gray-500 font-bold">
                  Documentation
                </div>
                <p className="text-xs text-gray-400 italic bg-obsidian-base/50 p-2.5 rounded-lg border border-obsidian-border/50">
                  {selectedNodeData.docstring}
                </p>
              </div>
            )}

            {/* Callers (Incoming Dependencies) */}
            <div className="space-y-2">
              <div className="text-[10px] font-mono uppercase text-gray-400 font-bold flex items-center justify-between">
                <span>Callers / Upstream ({selectedSymbolDetail?.callers.length || 0})</span>
              </div>
              {!selectedSymbolDetail || selectedSymbolDetail.callers.length === 0 ? (
                <p className="text-[11px] text-gray-500 italic">No incoming calls detected.</p>
              ) : (
                <div className="space-y-1.5 max-h-36 overflow-y-auto">
                  {selectedSymbolDetail.callers.map((c) => (
                    <div
                      key={c.id}
                      className="p-2 rounded-lg bg-obsidian-base border border-obsidian-border text-xs font-mono text-gray-300 flex items-center space-x-1.5"
                    >
                      <CornerDownRight className="w-3 h-3 text-electric-indigo shrink-0" />
                      <span className="truncate font-bold text-white">{c.name}</span>
                      <span className="text-[10px] text-gray-500 shrink-0">({c.kind})</span>
                    </div>
                  ))}
                </div>
              )}
            </div>

            {/* Callees (Outgoing Dependencies) */}
            <div className="space-y-2">
              <div className="text-[10px] font-mono uppercase text-gray-400 font-bold flex items-center justify-between">
                <span>Callees / Downstream ({selectedSymbolDetail?.callees.length || 0})</span>
              </div>
              {!selectedSymbolDetail || selectedSymbolDetail.callees.length === 0 ? (
                <p className="text-[11px] text-gray-500 italic">No outgoing calls detected.</p>
              ) : (
                <div className="space-y-1.5 max-h-36 overflow-y-auto">
                  {selectedSymbolDetail.callees.map((c) => (
                    <div
                      key={c.id}
                      className="p-2 rounded-lg bg-obsidian-base border border-obsidian-border text-xs font-mono text-gray-300 flex items-center space-x-1.5"
                    >
                      <ArrowRight className="w-3 h-3 text-electric-violet shrink-0" />
                      <span className="truncate font-bold text-white">{c.name}</span>
                      <span className="text-[10px] text-gray-500 shrink-0">({c.kind})</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
</file>

<file path="apps/web/components/SecurityAuditDashboard.tsx">
"use client";

import React, { useState, useEffect, useCallback } from "react";
import {
  ShieldAlert,
  ShieldCheck,
  AlertTriangle,
  Flame,
  CheckCircle2,
  RefreshCw,
  Search,
  Filter,
  ExternalLink,
  ChevronRight,
  Code2,
  Activity,
  Layers,
  Sparkles,
  ArrowRight,
  FileText,
  Lock,
  X,
  SlidersHorizontal,
} from "lucide-react";

interface DimensionsSummary {
  critical_security_findings?: number;
  high_security_findings?: number;
  medium_security_findings?: number;
  low_security_findings?: number;
  large_files_count?: number;
  large_functions_count?: number;
  high_complexity_functions?: number;
  circular_dependency_cycles?: number;
  average_fan_out?: number;
  ksloc?: number;
}

interface AuditSummary {
  id: string;
  repository_id: string;
  version_id: string;
  status: string;
  current_step: string;
  progress_percentage: number;
  step_details?: string;
  error_log?: string;
  health_score?: number;
  security_score?: number;
  maintainability_score?: number;
  complexity_score?: number;
  coupling_score?: number;
  architecture_score?: number;
  dimensions_summary?: DimensionsSummary;
  total_security_findings: number;
  total_quality_findings: number;
  started_at?: string;
  completed_at?: string;
}

interface SecurityFinding {
  id: string;
  rule_id: string;
  category: string;
  severity: "CRITICAL" | "HIGH" | "MEDIUM" | "LOW" | "INFO";
  confidence: number;
  detection_source: string;
  file_path: string;
  start_line: number;
  end_line: number;
  title: string;
  description: string;
  evidence: string;
  remediation: string;
  symbol_name?: string;
  graph_reachability_path?: string;
  is_ai_assisted: boolean;
  created_at: string;
}

interface QualityFinding {
  id: string;
  rule_id: string;
  metric_name: string;
  title: string;
  description: string;
  severity: "CRITICAL" | "HIGH" | "MEDIUM" | "LOW" | "INFO";
  confidence: number;
  detection_source: string;
  value: number;
  threshold: number;
  file_path: string;
  start_line: number;
  end_line: number;
  recommendation: string;
  symbol_name?: string;
  is_ai_assisted: boolean;
  created_at: string;
}

interface SecurityAuditDashboardProps {
  repositoryId: string;
  onNavigateToFile?: (filePath: string, startLine: number) => void;
}

const API_BASE = process.env.NEXT_PUBLIC_API_URL || "http://localhost:8000";

export default function SecurityAuditDashboard({
  repositoryId,
  onNavigateToFile,
}: SecurityAuditDashboardProps) {
  const [audit, setAudit] = useState<AuditSummary | null>(null);
  const [securityFindings, setSecurityFindings] = useState<SecurityFinding[]>([]);
  const [qualityFindings, setQualityFindings] = useState<QualityFinding[]>([]);
  const [loading, setLoading] = useState(true);
  const [isAuditing, setIsAuditing] = useState(false);
  const [auditProgress, setAuditProgress] = useState<{ step: string; progress: number; details: string } | null>(null);

  // Active view toggle: 'security' vs 'quality'
  const [activeSubView, setActiveSubView] = useState<"security" | "quality">("security");

  // Filters
  const [severityFilter, setSeverityFilter] = useState<string>("ALL");
  const [sourceFilter, setSourceFilter] = useState<string>("ALL");
  const [searchQuery, setSearchQuery] = useState<string>("");

  // Finding Drawer
  const [selectedSecurityFinding, setSelectedSecurityFinding] = useState<SecurityFinding | null>(null);
  const [selectedQualityFinding, setSelectedQualityFinding] = useState<QualityFinding | null>(null);

  // Fetch Latest Audit
  const fetchAuditData = useCallback(async () => {
    try {
      setLoading(true);
      const res = await fetch(`${API_BASE}/api/v1/repositories/${repositoryId}/audit/latest`);
      if (res.ok) {
        const auditData: AuditSummary = await res.json();
        setAudit(auditData);

        // Fetch findings
        const [secRes, qualRes] = await Promise.all([
          fetch(`${API_BASE}/api/v1/repositories/${repositoryId}/security/findings?audit_id=${auditData.id}&limit=100`),
          fetch(`${API_BASE}/api/v1/repositories/${repositoryId}/quality/findings?audit_id=${auditData.id}&limit=100`),
        ]);

        if (secRes.ok) {
          const secData = await secRes.json();
          setSecurityFindings(secData);
        }
        if (qualRes.ok) {
          const qualData = await qualRes.json();
          setQualityFindings(qualData);
        }
      } else {
        setAudit(null);
        setSecurityFindings([]);
        setQualityFindings([]);
      }
    } catch (err) {
      console.error("Failed to fetch audit data:", err);
    } finally {
      setLoading(false);
    }
  }, [repositoryId]);

  useEffect(() => {
    fetchAuditData();
  }, [fetchAuditData]);

  // Trigger Audit
  const handleTriggerAudit = async () => {
    try {
      setIsAuditing(true);
      setAuditProgress({ step: "QUEUED", progress: 5, details: "Dispatching audit job..." });

      const res = await fetch(`${API_BASE}/api/v1/repositories/${repositoryId}/audit`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ enable_ai_review: true }),
      });

      if (!res.ok) {
        throw new Error("Failed to trigger audit");
      }

      const data = await res.json();
      const auditRunId = data.audit_run_id;

      // Connect SSE
      const evtSource = new EventSource(`${API_BASE}/api/v1/repositories/audit/events/${auditRunId}`);
      evtSource.onmessage = (event) => {
        try {
          const msg = JSON.parse(event.data);
          setAuditProgress({
            step: msg.step,
            progress: msg.progress,
            details: msg.details,
          });

          if (msg.step === "COMPLETED" || msg.step === "FAILED") {
            evtSource.close();
            setIsAuditing(false);
            fetchAuditData();
          }
        } catch {
          // ignore parsing error
        }
      };

      evtSource.onerror = () => {
        evtSource.close();
        setIsAuditing(false);
        fetchAuditData();
      };
    } catch (err) {
      console.error("Audit error:", err);
      setIsAuditing(false);
    }
  };

  const getSeverityBadge = (severity: string) => {
    switch (severity) {
      case "CRITICAL":
        return "bg-rose-500/20 text-rose-400 border-rose-500/40";
      case "HIGH":
        return "bg-amber-500/20 text-amber-400 border-amber-500/40";
      case "MEDIUM":
        return "bg-yellow-500/20 text-yellow-400 border-yellow-500/40";
      case "LOW":
        return "bg-sky-500/20 text-sky-400 border-sky-500/40";
      default:
        return "bg-gray-500/20 text-gray-400 border-gray-500/40";
    }
  };

  const getScoreColor = (score?: number) => {
    if (score === undefined || score === null) return "text-gray-400";
    if (score >= 80) return "text-emerald-400";
    if (score >= 60) return "text-amber-400";
    return "text-rose-400";
  };

  // Filter Security Findings
  const filteredSecurityFindings = securityFindings.filter((f) => {
    if (severityFilter !== "ALL" && f.severity !== severityFilter) return false;
    if (sourceFilter !== "ALL" && f.detection_source !== sourceFilter) return false;
    if (searchQuery) {
      const q = searchQuery.toLowerCase();
      return (
        f.title.toLowerCase().includes(q) ||
        f.rule_id.toLowerCase().includes(q) ||
        f.file_path.toLowerCase().includes(q) ||
        f.category.toLowerCase().includes(q)
      );
    }
    return true;
  });

  // Filter Quality Findings
  const filteredQualityFindings = qualityFindings.filter((f) => {
    if (severityFilter !== "ALL" && f.severity !== severityFilter) return false;
    if (searchQuery) {
      const q = searchQuery.toLowerCase();
      return (
        f.title.toLowerCase().includes(q) ||
        f.metric_name.toLowerCase().includes(q) ||
        f.file_path.toLowerCase().includes(q)
      );
    }
    return true;
  });

  return (
    <div className="space-y-4">
      {/* Top Banner & Health Scorecard */}
      <div className="glass-card rounded-2xl p-5 border border-obsidian-border bg-gradient-to-r from-obsidian-surface via-obsidian-surface to-indigo-950/20">
        <div className="flex flex-wrap items-center justify-between gap-4">
          <div>
            <div className="flex items-center space-x-2.5">
              <ShieldAlert className="w-5 h-5 text-electric-indigo" />
              <h2 className="text-base font-bold text-white font-mono tracking-tight">
                Security & Code Quality Intelligence
              </h2>
              {audit?.status === "COMPLETED" && (
                <span className="px-2 py-0.5 rounded text-[10px] font-mono bg-electric-emerald/15 text-electric-emerald border border-electric-emerald/30">
                  Audit Verified
                </span>
              )}
            </div>
            <p className="text-xs text-gray-400 mt-1">
              Deterministic static analysis, AST complexity inspection, call-graph reachability, and grounded Gemini advisory.
            </p>
          </div>

          <div className="flex items-center space-x-3">
            <button
              onClick={handleTriggerAudit}
              disabled={isAuditing}
              className="px-4 py-2 rounded-xl bg-electric-indigo hover:bg-electric-indigo/80 text-white text-xs font-mono font-medium flex items-center space-x-2 transition shadow-glow disabled:opacity-50"
            >
              <RefreshCw className={`w-3.5 h-3.5 ${isAuditing ? "animate-spin" : ""}`} />
              <span>{isAuditing ? "Auditing Repository..." : "Run Security & Quality Audit"}</span>
            </button>
          </div>
        </div>

        {/* Live Audit Progress Bar */}
        {isAuditing && auditProgress && (
          <div className="mt-4 pt-4 border-t border-obsidian-border/80">
            <div className="flex items-center justify-between text-xs font-mono mb-1.5">
              <span className="text-electric-indigo font-bold flex items-center space-x-1.5">
                <Activity className="w-3.5 h-3.5 animate-pulse" />
                <span>Stage: {auditProgress.step}</span>
              </span>
              <span className="text-gray-400">{auditProgress.progress}%</span>
            </div>
            <div className="w-full bg-obsidian-base h-2 rounded-full overflow-hidden border border-obsidian-border">
              <div
                className="bg-electric-indigo h-full transition-all duration-300 shadow-glow"
                style={{ width: `${auditProgress.progress}%` }}
              />
            </div>
            <div className="text-[11px] font-mono text-gray-400 mt-1">
              {auditProgress.details}
            </div>
          </div>
        )}

        {/* 5-Dimension Health Metrics Cards */}
        {audit?.status === "COMPLETED" && (
          <div className="mt-5 grid grid-cols-2 md:grid-cols-6 gap-2.5 pt-4 border-t border-obsidian-border">
            {/* Overall Health Card */}
            <div className="col-span-2 md:col-span-1 glass-card p-3 rounded-xl border border-obsidian-border bg-obsidian-base/60 text-center">
              <div className="text-[10px] uppercase font-mono text-gray-400 tracking-wider">Health Score</div>
              <div className={`text-2xl font-bold font-mono mt-1 ${getScoreColor(audit.health_score)}`}>
                {audit.health_score ?? "N/A"}<span className="text-xs text-gray-500 font-normal">/100</span>
              </div>
              <div className="text-[10px] text-gray-400 mt-0.5">Composite Matrix</div>
            </div>

            {/* Security Score */}
            <div className="glass-card p-3 rounded-xl border border-obsidian-border bg-obsidian-base/40 text-center">
              <div className="text-[10px] uppercase font-mono text-gray-400 flex items-center justify-center space-x-1">
                <Lock className="w-2.5 h-2.5 text-rose-400" />
                <span>Security</span>
              </div>
              <div className={`text-xl font-bold font-mono mt-1 ${getScoreColor(audit.security_score)}`}>
                {audit.security_score ?? "N/A"}
              </div>
              <div className="text-[9px] text-gray-400 mt-0.5">
                {audit.total_security_findings} findings
              </div>
            </div>

            {/* Maintainability */}
            <div className="glass-card p-3 rounded-xl border border-obsidian-border bg-obsidian-base/40 text-center">
              <div className="text-[10px] uppercase font-mono text-gray-400 flex items-center justify-center space-x-1">
                <Code2 className="w-2.5 h-2.5 text-sky-400" />
                <span>Maintain</span>
              </div>
              <div className={`text-xl font-bold font-mono mt-1 ${getScoreColor(audit.maintainability_score)}`}>
                {audit.maintainability_score ?? "N/A"}
              </div>
              <div className="text-[9px] text-gray-400 mt-0.5">SLOC & Modules</div>
            </div>

            {/* Complexity */}
            <div className="glass-card p-3 rounded-xl border border-obsidian-border bg-obsidian-base/40 text-center">
              <div className="text-[10px] uppercase font-mono text-gray-400 flex items-center justify-center space-x-1">
                <Flame className="w-2.5 h-2.5 text-amber-400" />
                <span>Complexity</span>
              </div>
              <div className={`text-xl font-bold font-mono mt-1 ${getScoreColor(audit.complexity_score)}`}>
                {audit.complexity_score ?? "N/A"}
              </div>
              <div className="text-[9px] text-gray-400 mt-0.5">McCabe V(G)</div>
            </div>

            {/* Coupling */}
            <div className="glass-card p-3 rounded-xl border border-obsidian-border bg-obsidian-base/40 text-center">
              <div className="text-[10px] uppercase font-mono text-gray-400 flex items-center justify-center space-x-1">
                <Layers className="w-2.5 h-2.5 text-purple-400" />
                <span>Coupling</span>
              </div>
              <div className={`text-xl font-bold font-mono mt-1 ${getScoreColor(audit.coupling_score)}`}>
                {audit.coupling_score ?? "N/A"}
              </div>
              <div className="text-[9px] text-gray-400 mt-0.5">Fan-in / Fan-out</div>
            </div>

            {/* Architecture */}
            <div className="glass-card p-3 rounded-xl border border-obsidian-border bg-obsidian-base/40 text-center">
              <div className="text-[10px] uppercase font-mono text-gray-400 flex items-center justify-center space-x-1">
                <Activity className="w-2.5 h-2.5 text-emerald-400" />
                <span>Architecture</span>
              </div>
              <div className={`text-xl font-bold font-mono mt-1 ${getScoreColor(audit.architecture_score)}`}>
                {audit.architecture_score ?? "N/A"}
              </div>
              <div className="text-[9px] text-gray-400 mt-0.5">
                {audit.dimensions_summary?.circular_dependency_cycles || 0} cycles
              </div>
            </div>
          </div>
        )}
      </div>

      {/* Main Workspace: Controls & Findings */}
      <div className="glass-card rounded-2xl p-5 border border-obsidian-border space-y-4">
        {/* Sub-view Switcher & Filters */}
        <div className="flex flex-wrap items-center justify-between gap-3">
          {/* View Toggle */}
          <div className="flex items-center space-x-1 bg-obsidian-base p-1 rounded-xl border border-obsidian-border text-xs font-mono">
            <button
              onClick={() => setActiveSubView("security")}
              className={`px-3 py-1.5 rounded-lg flex items-center space-x-1.5 transition ${
                activeSubView === "security"
                  ? "bg-electric-indigo text-white font-bold shadow-glow"
                  : "text-gray-400 hover:text-white"
              }`}
            >
              <ShieldAlert className="w-3.5 h-3.5 text-rose-400" />
              <span>Security Findings ({securityFindings.length})</span>
            </button>
            <button
              onClick={() => setActiveSubView("quality")}
              className={`px-3 py-1.5 rounded-lg flex items-center space-x-1.5 transition ${
                activeSubView === "quality"
                  ? "bg-electric-indigo text-white font-bold shadow-glow"
                  : "text-gray-400 hover:text-white"
              }`}
            >
              <Code2 className="w-3.5 h-3.5 text-sky-400" />
              <span>Code Quality ({qualityFindings.length})</span>
            </button>
          </div>

          {/* Search Bar */}
          <div className="relative flex-1 max-w-xs">
            <Search className="w-3.5 h-3.5 absolute left-3 top-3 text-gray-400" />
            <input
              type="text"
              placeholder="Search findings, rule ID, path..."
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              className="w-full pl-9 pr-3 py-1.5 bg-obsidian-base rounded-xl border border-obsidian-border text-xs text-white placeholder-gray-500 font-mono focus:outline-none focus:border-electric-indigo"
            />
          </div>

          {/* Filter Pills */}
          <div className="flex items-center space-x-2 text-xs font-mono">
            <span className="text-gray-500 flex items-center space-x-1">
              <SlidersHorizontal className="w-3 h-3" />
              <span>Severity:</span>
            </span>
            <select
              value={severityFilter}
              onChange={(e) => setSeverityFilter(e.target.value)}
              className="bg-obsidian-base border border-obsidian-border rounded-lg px-2 py-1 text-xs text-gray-300 font-mono focus:outline-none"
            >
              <option value="ALL">All Severities</option>
              <option value="CRITICAL">Critical</option>
              <option value="HIGH">High</option>
              <option value="MEDIUM">Medium</option>
              <option value="LOW">Low</option>
              <option value="INFO">Info</option>
            </select>

            {activeSubView === "security" && (
              <select
                value={sourceFilter}
                onChange={(e) => setSourceFilter(e.target.value)}
                className="bg-obsidian-base border border-obsidian-border rounded-lg px-2 py-1 text-xs text-gray-300 font-mono focus:outline-none"
              >
                <option value="ALL">All Sources</option>
                <option value="STATIC_RULE">Static Rule</option>
                <option value="AST_ANALYSIS">AST Analysis</option>
                <option value="GRAPH_ANALYSIS">Graph Analysis</option>
                <option value="AI_ANALYSIS">AI Analysis</option>
              </select>
            )}
          </div>
        </div>

        {/* Findings List View */}
        {loading ? (
          <div className="text-center py-12">
            <RefreshCw className="w-6 h-6 animate-spin text-electric-indigo mx-auto mb-2" />
            <p className="text-xs text-gray-400 font-mono">Loading codebase intelligence findings...</p>
          </div>
        ) : !audit ? (
          <div className="text-center py-12 border border-dashed border-obsidian-border rounded-xl">
            <ShieldCheck className="w-10 h-10 text-gray-600 mx-auto mb-2" />
            <p className="text-sm font-bold text-gray-300 font-mono">No Audit Runs Yet</p>
            <p className="text-xs text-gray-500 mt-1 max-w-md mx-auto">
              Click &quot;Run Security & Quality Audit&quot; above to initiate an automated deterministic and graph-aware analysis of this repository.
            </p>
          </div>
        ) : activeSubView === "security" ? (
          /* Security Findings Table */
          <div className="space-y-2">
            {filteredSecurityFindings.length === 0 ? (
              <div className="text-center py-8 text-xs text-gray-400 font-mono">
                No security findings matching current filters.
              </div>
            ) : (
              filteredSecurityFindings.map((finding) => (
                <div
                  key={finding.id}
                  onClick={() => setSelectedSecurityFinding(finding)}
                  className={`p-3.5 rounded-xl border transition cursor-pointer flex items-start justify-between gap-4 ${
                    selectedSecurityFinding?.id === finding.id
                      ? "bg-electric-indigo/10 border-electric-indigo shadow-glow"
                      : "bg-obsidian-base/50 border-obsidian-border hover:border-gray-700"
                  }`}
                >
                  <div className="space-y-1.5 flex-1 min-w-0">
                    <div className="flex items-center space-x-2">
                      <span
                        className={`px-2 py-0.5 rounded text-[10px] font-mono font-bold border ${getSeverityBadge(
                          finding.severity
                        )}`}
                      >
                        {finding.severity}
                      </span>
                      <span className="text-[10px] font-mono text-gray-400 bg-obsidian-border/50 px-1.5 py-0.5 rounded">
                        {finding.rule_id}
                      </span>
                      <span className="text-xs font-mono font-semibold text-white truncate">
                        {finding.title}
                      </span>
                      {finding.is_ai_assisted && (
                        <span className="flex items-center space-x-1 text-[10px] font-mono text-electric-indigo bg-electric-indigo/15 border border-electric-indigo/30 px-1.5 py-0.5 rounded">
                          <Sparkles className="w-2.5 h-2.5" />
                          <span>AI Assisted</span>
                        </span>
                      )}
                    </div>

                    <div className="text-xs text-gray-400 line-clamp-1">
                      {finding.description}
                    </div>

                    <div className="flex flex-wrap items-center gap-3 text-[11px] font-mono text-gray-400">
                      <span className="flex items-center space-x-1 text-gray-300">
                        <FileText className="w-3 h-3 text-gray-500" />
                        <span>
                          {finding.file_path}:{finding.start_line}
                        </span>
                      </span>
                      <span>Category: {finding.category}</span>
                      <span>Source: {finding.detection_source}</span>
                      <span>Confidence: {Math.round(finding.confidence * 100)}%</span>
                      {finding.graph_reachability_path && (
                        <span className="text-electric-amber flex items-center space-x-1">
                          <Activity className="w-3 h-3" />
                          <span>Reachable from Entrypoint</span>
                        </span>
                      )}
                    </div>
                  </div>

                  <ChevronRight className="w-4 h-4 text-gray-500 mt-2 flex-shrink-0" />
                </div>
              ))
            )}
          </div>
        ) : (
          /* Quality Findings Table */
          <div className="space-y-2">
            {filteredQualityFindings.length === 0 ? (
              <div className="text-center py-8 text-xs text-gray-400 font-mono">
                No quality findings matching current filters.
              </div>
            ) : (
              filteredQualityFindings.map((finding) => (
                <div
                  key={finding.id}
                  onClick={() => setSelectedQualityFinding(finding)}
                  className={`p-3.5 rounded-xl border transition cursor-pointer flex items-start justify-between gap-4 ${
                    selectedQualityFinding?.id === finding.id
                      ? "bg-electric-indigo/10 border-electric-indigo shadow-glow"
                      : "bg-obsidian-base/50 border-obsidian-border hover:border-gray-700"
                  }`}
                >
                  <div className="space-y-1.5 flex-1 min-w-0">
                    <div className="flex items-center space-x-2">
                      <span
                        className={`px-2 py-0.5 rounded text-[10px] font-mono font-bold border ${getSeverityBadge(
                          finding.severity
                        )}`}
                      >
                        {finding.severity}
                      </span>
                      <span className="text-[10px] font-mono text-gray-400 bg-obsidian-border/50 px-1.5 py-0.5 rounded">
                        {finding.rule_id}
                      </span>
                      <span className="text-xs font-mono font-semibold text-white truncate">
                        {finding.title}
                      </span>
                    </div>

                    <div className="text-xs text-gray-400 line-clamp-1">
                      {finding.description}
                    </div>

                    <div className="flex flex-wrap items-center gap-3 text-[11px] font-mono text-gray-400">
                      <span className="flex items-center space-x-1 text-gray-300">
                        <FileText className="w-3 h-3 text-gray-500" />
                        <span>
                          {finding.file_path}:{finding.start_line}
                        </span>
                      </span>
                      <span>Metric: {finding.metric_name}</span>
                      <span>Value: {finding.value}</span>
                      <span>Threshold: {finding.threshold}</span>
                    </div>
                  </div>

                  <ChevronRight className="w-4 h-4 text-gray-500 mt-2 flex-shrink-0" />
                </div>
              ))
            )}
          </div>
        )}
      </div>

      {/* Slide-out Finding Inspector Drawer for Security */}
      {selectedSecurityFinding && (
        <div className="glass-card rounded-2xl p-5 border border-electric-indigo/40 bg-obsidian-surface/95 space-y-4 shadow-2xl">
          <div className="flex items-start justify-between">
            <div className="space-y-1">
              <div className="flex items-center space-x-2">
                <span
                  className={`px-2 py-0.5 rounded text-[10px] font-mono font-bold border ${getSeverityBadge(
                    selectedSecurityFinding.severity
                  )}`}
                >
                  {selectedSecurityFinding.severity}
                </span>
                <span className="text-xs font-mono text-gray-400">
                  {selectedSecurityFinding.rule_id}
                </span>
                <span className="text-sm font-bold text-white font-mono">
                  {selectedSecurityFinding.title}
                </span>
              </div>
              <div className="text-xs font-mono text-gray-400">
                Location: {selectedSecurityFinding.file_path} (Lines {selectedSecurityFinding.start_line}-
                {selectedSecurityFinding.end_line})
              </div>
            </div>

            <div className="flex items-center space-x-2">
              {onNavigateToFile && (
                <button
