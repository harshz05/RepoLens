            cits = cit_res.scalars().all()

            msg_list.append(
                ChatMessageSchema(
                    id=m.id,
                    role=m.role,
                    content=m.content,
                    created_at=m.created_at,
                    citations=[
                        CitationSchema(
                            file_path=c.file_path,
                            start_line=c.start_line,
                            end_line=c.end_line,
