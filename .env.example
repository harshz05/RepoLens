# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# FastAPI Backend Configuration
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=dev_secret_key_repolens_2026_super_secure_change_in_prod

# Production Database (PostgreSQL 16 + pgvector)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/repolens
# For local dev without Postgres running, backend falls back gracefully if SQLITE_DEV_FALLBACK=true:
SQLITE_DEV_FALLBACK=true
DATABASE_URL=sqlite+aiosqlite:///./repolens_dev.db

# Production Redis (Task Queue & Pub/Sub)
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_DEV_FALLBACK=true

# Google Gemini API
GEMINI_API_KEY=

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
